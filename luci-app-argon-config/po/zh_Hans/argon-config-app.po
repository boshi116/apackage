#: htdocs/luci-static/resources/view/argon-config-app.js:141
msgid ""
"Background uploaded. Select the local wallpaper source and save to use it."
msgstr "背景已上传。选择本地壁纸来源并保存后即可使用。"

#: htdocs/luci-static/resources/view/argon-config-app.js:145
msgid "Upload has been cancelled"
msgstr "已取消上传"

#: htdocs/luci-static/resources/view/argon-config-app.js:153
