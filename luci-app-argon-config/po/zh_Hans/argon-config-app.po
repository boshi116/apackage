msgid "Cancel"
msgstr "取消"

#: htdocs/luci-static/resources/view/argon-config-app.js:178
msgid "Close"
msgstr "关闭"

#: htdocs/luci-static/resources/view/argon-config-app.js:191
msgid "Preview"
msgstr "预览"

#: htdocs/luci-static/resources/view/argon-config-app.js:203
msgid ""
"Customize the login page and manage local backgrounds. Changes take effect "
"after Save & Apply."
msgstr "自定义登录页面并管理本地背景，修改将在“保存并应用”后生效。"

#: htdocs/luci-static/resources/view/argon-config-app.js:207
msgid "General"
msgstr "常规"

#: htdocs/luci-static/resources/view/argon-config-app.js:59
msgid "Local backgrounds (built-in if empty)"
msgstr "本地背景（为空时使用内置背景）"

#: htdocs/luci-static/resources/view/argon-config-app.js:222
msgid "Primary color"
msgstr "主色调"

#: htdocs/luci-static/resources/view/argon-config-app.js:224
msgid "Use a HEX color such as #5e72e4 or #fff."
msgstr "使用十六进制颜色值，例如 #5e72e4 或 #fff。"

#: htdocs/luci-static/resources/view/argon-config-app.js:227
msgid "Transparency"
msgstr "透明度"

#: htdocs/luci-static/resources/view/argon-config-app.js:230
msgid "0 is transparent; 1 is opaque."
msgstr "0 为完全透明，1 为不透明。"

#: htdocs/luci-static/resources/view/argon-config-app.js:232
msgid "Frosted glass radius"
msgstr "毛玻璃模糊半径"

#: htdocs/luci-static/resources/view/argon-config-app.js:235
msgid "Blur radius in pixels, from 0 to 100."
msgstr "模糊半径，单位为像素，范围为 0 至 100。"

#: htdocs/luci-static/resources/view/argon-config-app.js:250
msgid "Local backgrounds"
msgstr "本地背景"

#: htdocs/luci-static/resources/view/argon-config-app.js:252
msgid ""
"Uploads and deletions take effect immediately and do not discard unsaved "
"theme settings."
msgstr "上传和删除立即生效，不会丢失尚未保存的主题设置。"

#: htdocs/luci-static/resources/view/argon-config-app.js:259
msgid "Refresh"
msgstr "刷新"

#: htdocs/luci-static/resources/view/argon-config-app.js:63
msgid ""
"Local backgrounds are selected randomly. Online sources require Internet "
"access."
msgstr "随机使用已上传的本地背景，在线来源需要联网。"

#: htdocs/luci-static/resources/view/argon-config-app.js:73
msgid "Unsplash collection IDs (optional)"
msgstr "Unsplash 合集 ID（可选）"

#: htdocs/luci-static/resources/view/argon-config-app.js:73
msgid "Wallhaven tag ID (optional)"
msgstr "Wallhaven 标签 ID（可选）"

#: htdocs/luci-static/resources/view/argon-config-app.js:77
msgid ""
"Enter public collection IDs separated by commas. Leave empty for random "
"photos."
msgstr "填写公开合集 ID，多个 ID 用逗号分隔；留空使用随机图片。"

#: htdocs/luci-static/resources/view/argon-config-app.js:78
msgid ""
"Enter one numeric tag ID, not a wallpaper ID. A tag enables the API key and "
"resolution options below."
msgstr "填写一个数字标签 ID，而非壁纸 ID。填写标签后可设置下方的 API 密钥和分辨率筛选。"

#: htdocs/luci-static/resources/view/argon-config-app.js:86
msgid "Use collection IDs separated by commas, without URLs."
msgstr "请填写用逗号分隔的合集 ID，不要填写网址。"

#: htdocs/luci-static/resources/view/argon-config-app.js:86
msgid "Use one positive numeric tag ID."
msgstr "请填写一个正整数标签 ID。"

#: htdocs/luci-static/resources/view/argon-config-app.js:101
msgid "Wallpaper API key"
msgstr "壁纸 API 密钥"

#: htdocs/luci-static/resources/view/argon-config-app.js:106
msgid ""
"Unsplash requires its Access Key. For a Wallhaven tag search, use a "
"Wallhaven API key or leave empty."
msgstr "Unsplash 必须填写其 Access Key；Wallhaven 标签搜索可填写对应的 API 密钥，也可留空。"

#: htdocs/luci-static/resources/view/argon-config-app.js:108
msgid "An Unsplash Access Key is required."
msgstr "使用 Unsplash 时必须填写 Access Key。"

#: htdocs/luci-static/resources/view/argon-config-app.js:110
msgid "Require exact resolution for Wallhaven"
msgstr "Wallhaven 使用精确分辨率"

#: htdocs/luci-static/resources/view/argon-config-app.js:115
msgid ""
"For tag searches: require 1920x1080, or disable to allow images at least "
"1920x1080."
msgstr "适用于标签搜索：开启时要求 1920×1080；关闭后允许至少 1920×1080 的图片。"
