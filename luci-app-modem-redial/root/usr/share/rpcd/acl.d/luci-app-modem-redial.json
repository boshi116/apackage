{
	"luci-app-modem-redial": {
		"description": "Grant access to modem_redial",
		"read": {
			"uci": [ "modem_redial" ],
			"file": {
				"/tmp/log/modem_redial.log": [ "read" ],
				"/tmp/log/modem_redial_live_qos.log": [ "read" ],
				"/tmp/run/modem_redial.pid": [ "read" ],
				"/etc/modem_redial_qos.log": [ "read" ],
				"/usr/bin/modem_redial": [ "exec" ],
				"/usr/bin/modem_redial *": [ "exec" ],
				"/usr/bin/modem_redial.py": [ "exec" ],
				"/usr/bin/modem_redial.py *": [ "exec" ]
			},
			"ubus": {
				"file": [ "read", "exec" ]
			}
		},
		"write": {
			"uci": [ "modem_redial" ],
			"file": {
				"/tmp/log/modem_redial.log": [ "write" ],
				"/tmp/log/modem_redial_live_qos.log": [ "write" ],
				"/etc/modem_redial_qos.log": [ "write" ],
				"/usr/bin/modem_redial": [ "exec" ],
				"/usr/bin/modem_redial *": [ "exec" ],
				"/usr/bin/modem_redial.py": [ "exec" ],
				"/usr/bin/modem_redial.py *": [ "exec" ]
			},
			"ubus": {
				"file": [ "write", "exec" ]
			}
		}
	}
}
